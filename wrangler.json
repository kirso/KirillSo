{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kirillso",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"vars": {
		"PUBLIC_ENABLE_CHAT": "true",
		"WEBMENTION_URL": "https://webmention.io/www.kirillso.com/webmention",
		"WEBMENTION_PINGBACK": "https://webmention.io/www.kirillso.com/xmlrpc"
	}
}
