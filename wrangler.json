{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kirillso",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{ "pattern": "www.kirillso.com", "custom_domain": true },
		{ "pattern": "kirillso.com", "custom_domain": true }
	],
	"ratelimits": [
		{
			"name": "CHAT_RATE_LIMITER",
			"namespace_id": "1018",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"vars": {
		"PUBLIC_ENABLE_CHAT": "true",
		"WEBMENTION_URL": "https://webmention.io/www.kirillso.com/webmention",
		"WEBMENTION_PINGBACK": "https://webmention.io/www.kirillso.com/xmlrpc"
	}
}
