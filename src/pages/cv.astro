};

interface Role {
	title: string;
	company: string;
	companyUrl?: string;
	location: string;
	period: string;
	highlights: string[];
}

const experience: Role[] = [
	{
		title: "Product Builder",
		company: "Career break",
		period: "2026 — Present",
		location: "Remote",
		highlights: [
			"Keepsake — an AI-powered family storytelling and memory app with speech-to-text transcription and smart book layouts using Groq inference and AssemblyAI. Secured $10k grant and 100+ pre-launch registrations via product-market-fit validation sprint",
			"AI Work Index — job displacement research based on occupation and labor market data",
			"Pictogram — a self-compounding brand identity API for developers and agents",
			"Growthrat — a developer advocacy agent that runs content experiments",
		],
	},
	{
		title: "Principal Product Manager (M2 / IC5)",
		company: "Delivery Hero",
		companyUrl: "https://www.deliveryhero.com/",
		period: "2022 — 2026",
		location: "Singapore",
		highlights: [
			"Shipped 0-to-1 API gateway infrastructure product, orchestrating incentive data across 21 markets in Europe and APAC, driving platform profitability",
			"Led cross-functional strategy and roadmap execution across 2 PMs and 4 engineering teams",
			"Centralized architecture that resolved UX inconsistencies in 21 countries, affecting 50m+ users and saving 50 hours/month in engineering capacity",
			"Launched a high-value actions initiative to lift acquisition, retention, and subscription metrics, on track to generate $100m/year in incremental GMV",
			"Built a new incentive component that produced $16.5m in GMV uplift",
		],
	},
	{
		title: "Product Manager, Growth",
		company: "Standard Chartered, Ventures",
		period: "2020 — 2022",
		location: "Singapore",
		highlights: [
			"Grew a consumer-facing mobile app to 100k MAU in 12 months via 3rd party integrations, SDKs, partnerships & cross-sell channels",
		],
	},
	{
		title: "Entrepreneur in Residence",
		company: "Antler",
		companyUrl: "https://www.antler.co/",
		period: "2019 — 2020",
		location: "Singapore",
		highlights: [
			"Validated market assumptions for an ML deployment optimization tool through 50+ customer interviews and prototype testing, ultimately disproving the hypothesis",
		],
	},
	{
		title: "Entrepreneur in Residence",
		company: "Carousell",
		companyUrl: "https://www.carousell.com/",
		period: "2018 — 2019",
		location: "Singapore",
		highlights: [
			"Built MVP for decentralized identity platform targeting fraud prevention, securing 30+ data partnerships to validate product-market fit and establish distribution channels",
		],
	},
	{
		title: "Director, Business Development",
		company: "Remerge",
		companyUrl: "https://www.remerge.io/",
		period: "2015 — 2018",
		location: "Berlin",
		highlights: [
			"Delivered over $50m in advertising budgets",
			"Closed strategic accounts while working closely with cross-functional teams and leadership",
		],
	},
	{
		title: "Business Development Manager",
		company: "IONIQ Group",
		companyUrl: "https://www.ioniq.com/",
		period: "2012 — 2015",
		location: "Berlin",
		highlights: [
			"Acquired and managed a $1m+ sales pipeline",
			"Worked with game publishers, advertising networks, entertainment and media outlets, and TV stations",
		],
	},
	{
		title: "Analyst, Private Equity",
		company: "EnerCap Capital Partners",
		companyUrl: "https://www.enercap.com/",
		period: "2010 — 2012",
		location: "Prague",
		highlights: [
			"Supported partners in raising $450m+ debt financing for renewable energy projects",
			"Projects provided electricity to 200,000 households and saved 130,000 tonnes of CO2 p.a.",
		],
	},
];

interface SkillGroup {
	label: string;
	items: string[];
}

const skills: SkillGroup[] = [
	{
		label: "Product management",
		items: [
			"Product lifecycle",
			"Feature definition",
			"Cross-functional collaboration",
			"Competitive analysis",
			"Agile",
			"Product strategy",
		],
	},
	{
		label: "Collaboration tools",
		items: ["Microsoft Teams", "Slack", "Jira", "Confluence", "Notion", "Linear"],
	},
	{
