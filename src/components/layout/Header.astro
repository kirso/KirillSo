---
/**
 * Classic Paper Blog Header
 * - Site name on left
 * - Slash-separated navigation on right
 * - Clean, simple, 2000s blog aesthetic
 */
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks } from "@/site.config";
---

<header class="mb-12 flex items-center justify-between border-b border-border pb-8" id="main-header">
  <a
    aria-current={Astro.url.pathname === "/" ? "page" : false}
    href="/"
  >
    {
      Astro.url.pathname === "/" ? (
        <h1 class="font-semibold tracking-tight" style="font-size: var(--text-large);">Kirill So</h1>
      ) : (
        <span class="font-semibold tracking-tight" style="font-size: var(--text-large);">Kirill So</span>
      )
    }
  </a>

  <div class="flex items-center gap-4">
    <!-- Desktop nav with slashes -->
    <nav
      aria-label="Main menu"
      class="hidden items-center sm:flex"
      id="navigation-menu"
    >
      {
        menuLinks.map((link, index) => (
          <>
            {index > 0 && <span class="mx-2 text-text-tertiary">/</span>}
            <a
              aria-current={Astro.url.pathname === link.path ? "page" : false}
              class:list={[
                "transition-colors",
                Astro.url.pathname === link.path
                  ? "text-global-text underline underline-offset-4"
                  : "link-nav"
              ]}
              style="font-size: var(--text-body);"
              data-astro-prefetch
              href={link.path}
            >
              {link.title.toLowerCase()}
            </a>
          </>
        ))
      }
    </nav>

    <a
      href="/rss.xml"
      class="hidden text-text-secondary transition-colors hover:text-global-text sm:block"
      title="RSS Feed"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
      </svg>
      <span class="sr-only">RSS Feed</span>
    </a>
    <Search />
    <ThemeToggle />

    <!-- Mobile menu button -->
    <mobile-button class="sm:hidden">
      <button
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="relative -m-2.5 box-content h-6 w-6 p-2.5 text-text-secondary transition-colors hover:text-global-text"
        id="toggle-navigation-menu"
        type="button"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          aria-hidden="true"
          class="h-full w-full"
          fill="none"
          focusable="false"
          stroke="currentColor"
          stroke-width="1.5"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M3.75 9h16.5m-16.5 6.75h16.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </mobile-button>
  </div>
</header>

<!-- Mobile backdrop -->
<div
  class="fixed inset-0 z-40 bg-global-text/40 opacity-0 backdrop-blur-sm transition-opacity duration-200 pointer-events-none sm:hidden"
  id="mobile-backdrop"
  aria-hidden="true"
></div>

<!-- Mobile menu (slides down). Inert while closed so it stays out of the Tab order -->
<nav
  aria-label="Mobile menu"
  class="fixed inset-x-0 top-0 z-50 -translate-y-full bg-global-bg px-5 py-4 shadow-sm transition-transform duration-200 ease-out sm:hidden"
  id="mobile-menu"
  inert
>
  <div class="flex items-center justify-between">
    <a href="/" class="font-semibold tracking-tight" style="font-size: var(--text-large);">Kirill So</a>
    <button
      class="-m-2.5 p-2.5 text-text-secondary hover:text-global-text"
      id="close-mobile-menu"
      type="button"
    >
      <span class="sr-only">Close menu</span>
      <svg
        aria-hidden="true"
        class="h-6 w-6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        viewBox="0 0 24 24"
      >
        <path
          d="M6 18L18 6M6 6l12 12"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
  <div class="mt-6 flex flex-col gap-1">
    {
      menuLinks.map((link) => (
        <a
          aria-current={Astro.url.pathname === link.path ? "page" : false}
          class:list={[
            "py-1.5 transition-colors",
            Astro.url.pathname === link.path
              ? "text-global-text underline underline-offset-4"
              : "link-nav"
          ]}
          style="font-size: var(--text-large);"
          href={link.path}
        >
          {link.title.toLowerCase()}
        </a>
      ))
    }
  </div>
</nav>

<script>
  class MobileNavBtn extends HTMLElement {
    connectedCallback() {
      const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");
      const mobileMenu = document.getElementById("mobile-menu");
      const backdrop = document.getElementById("mobile-backdrop");
      const closeBtn = document.getElementById("close-mobile-menu");

      const isOpen = () => mobileButtonEl?.getAttribute("aria-expanded") === "true";

      // While the menu is open, everything else on the page is inert so focus stays in the menu
      const pageRegions = () =>
        [...document.body.children].filter(
          (el) => el !== mobileMenu && el !== backdrop && el.tagName !== "SCRIPT",
        );

      const openMenu = () => {
        for (const el of pageRegions()) el.setAttribute("inert", "");
        mobileMenu?.removeAttribute("inert");
        mobileMenu?.classList.remove("-translate-y-full");
        mobileMenu?.classList.add("translate-y-0");
        backdrop?.classList.remove("opacity-0", "pointer-events-none");
        backdrop?.classList.add("opacity-100", "pointer-events-auto");
        mobileButtonEl?.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
        // preventScroll: the header isn't sticky, so a plain focus() scrolls the page back to the top
        closeBtn?.focus({ preventScroll: true });
      };

      const closeMenu = ({ restoreFocus = true } = {}) => {
        if (!isOpen()) return;
        for (const el of pageRegions()) el.removeAttribute("inert");
        mobileMenu?.setAttribute("inert", "");
        mobileMenu?.classList.remove("translate-y-0");
        mobileMenu?.classList.add("-translate-y-full");
        backdrop?.classList.remove("opacity-100", "pointer-events-auto");
        backdrop?.classList.add("opacity-0", "pointer-events-none");
        mobileButtonEl?.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
        if (restoreFocus) mobileButtonEl?.focus({ preventScroll: true });
      };

      mobileButtonEl?.addEventListener("click", openMenu);
      closeBtn?.addEventListener("click", () => closeMenu());
      backdrop?.addEventListener("click", () => closeMenu());

      window.matchMedia("(min-width: 640px)").addEventListener("change", ({ matches }) => {
        if (matches && isOpen()) {
          closeMenu({ restoreFocus: false });
          document.querySelector<HTMLElement>("#main-header a")?.focus({ preventScroll: true });
        }
      });

      // Close on link click; focus moves to the new page instead
      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => closeMenu({ restoreFocus: false }));
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isOpen()) closeMenu();
      });
    }
  }

  customElements.define("mobile-button", MobileNavBtn);
</script>
