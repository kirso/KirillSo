---
interface Props {
  rows?: number;
  variant?: "post-row" | "text";
  /** Stack title and author on narrow screens, like .post-row does */
  stackOnMobile?: boolean;
}

const { rows = 5, variant = "post-row", stackOnMobile = false } = Astro.props;
---

<div class:list={["skeleton-list", stackOnMobile && "skeleton-stack"]}>
  {Array.from({ length: rows }).map((_, i) => (
    <div class:list={["skeleton-row", variant === "text" && "skeleton-text"]}>
      <span class="skeleton-title" style={`animation-delay: ${i * 0.1}s`}></span>
      {variant === "post-row" && (
        <span class="skeleton-author" style={`animation-delay: ${i * 0.1 + 0.05}s`}></span>
      )}
    </div>
  ))}
</div>

<style>
  /* Row height and gap mirror the .post-row lists the islands render, so swapping in content doesn't shift the page */
  .skeleton-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .skeleton-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 1.75rem;
  }

  @media (max-width: 639px) {
    .skeleton-stack .skeleton-row {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: var(--space-1-5);
      min-height: 3.6rem;
    }

    .skeleton-stack .skeleton-title {
      flex: none;
      width: 85%;
    }

    .skeleton-stack .skeleton-author {
      width: 40%;
    }
  }

  .skeleton-title {
    height: 1rem;
    flex: 1;
    background: var(--color-rule);
    opacity: 0.5;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-author {
    height: 0.875rem;
    width: 25%;
    flex-shrink: 0;
    background: var(--color-rule);
    opacity: 0.3;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-text .skeleton-title {
    width: 80%;
    flex: none;
  }

  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.6;
    }
  }
</style>
